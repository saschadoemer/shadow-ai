{
  "name": "shadow-ai",
  "version": "0.0.0",
  "private": true,
  "description": "A browser game in pixel-art 2D about shadow AI in a mid-sized company.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen-tiles": "node tools/gen-tiles.ts",
    "gen-sprites": "node tools/gen-sprites.ts",
    "gen-campus": "node tools/gen-campus.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
